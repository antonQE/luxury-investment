# Local development defaults. Copy to .env and adjust if needed; .env is never committed.

# PostgreSQL from docker-compose.yml (host port 54329 avoids clashing with a local Postgres on 5432)
DATABASE_URL=postgres://luxury:luxury@localhost:54329/luxury_dev
TEST_DATABASE_URL=postgres://luxury:luxury@localhost:54329/luxury_test

# Public web (Next.js) — optional; defaults exist in code
# API_URL=http://localhost:4000
# SITE_URL=http://localhost:3000
# Browser-side calls from inquiry forms (must be reachable from the visitor’s browser)
# NEXT_PUBLIC_API_URL=http://localhost:4000

# Admin (Vite) — see also apps/admin/.env.example
# VITE_API_URL=http://localhost:4000

# Staff auth (API) — opaque sessions in Postgres; change the secret outside local
# AUTH_SESSION_SECRET=replace-with-a-long-random-string
# AUTH_COOKIE_NAME=li_session
# AUTH_SESSION_TTL_HOURS=168

# Media (API) — local disk adapter (ADR-0010); folder is gitignored
# MEDIA_LOCAL_ROOT=.data/media
# MEDIA_PUBLIC_BASE_URL=http://localhost:4000/v1/public/media

# Inquiry notifications (API) — log stub for R1 (ADR-0011); catch-all until per-agent routing
# INQUIRY_NOTIFY_TO=inquiries@example.com
