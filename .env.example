# Local development defaults. Copy to .env and adjust if needed; .env is never committed.

# PostgreSQL from docker-compose.yml (host port 54329 avoids clashing with a local Postgres on 5432)
DATABASE_URL=postgres://luxury:luxury@localhost:54329/luxury_dev
TEST_DATABASE_URL=postgres://luxury:luxury@localhost:54329/luxury_test

# Public web (Next.js) — optional; defaults exist in code
# API_URL=http://localhost:4000
# SITE_URL=http://localhost:3000

# Admin (Vite) — see also apps/admin/.env.example
# VITE_API_URL=http://localhost:4000
